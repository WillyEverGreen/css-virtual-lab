{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "^/api/(.*)$",
      "dest": "https://crypto-virtual-lab.collacou.workers.dev/api/$1"
    },
    {
      "src": "^/experiments/(?<slug>[^/]+)/(?<file>.+\\.(?:html|css|js|json|png|svg|jpg|jpeg|gif|webp|woff|woff2|ttf|eot))$",
      "dest": "/experiments/$slug/$file"
    },
    {
      "src": "^/experiments/[^/]+/?$",
      "dest": "/index.html"
    },
    {
      "src": "^/icons/(.*)$",
      "dest": "/icons/$1"
    },
    {
      "src": "^/images/(.*)$",
      "dest": "/images/$1"
    },
    {
      "src": "^/fonts/(.*)$",
      "dest": "/fonts/$1"
    },
    {
      "src": "^/assets/(.*)$",
      "dest": "/assets/$1"
    },
    {
      "src": "^/js/(.*)$",
      "dest": "/js/$1"
    },
    {
      "src": "^/css/(.*)$",
      "dest": "/css/$1"
    },
    {
      "src": "^/favicon.*",
      "dest": "/favicon.svg"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/.*$",
      "dest": "/index.html"
    }
  ]
}
